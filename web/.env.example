# Copy to .env.local and fill in. Everything here stays on the server.

# OpenAI key for the agent (question writer and team radio)
OPENAI_API_KEY=
# Optional, defaults to gpt-5.4-mini
OPENAI_MODEL=

# Sanity organization token with the Context Viewer role (Manage > API > Tokens at org level)
SANITY_ORG_TOKEN=
SANITY_ORG_ID=
# Names of the two Context MCP endpoints
SANITY_MCP_DATA=pit-wall-data
SANITY_MCP_RULES=pit-wall-rules

# Project token with the Editor role, used to store questions and finished races
SANITY_WRITE_TOKEN=

# Optional: key for encrypting answer tokens; defaults to a hash of OPENAI_API_KEY
QUIZ_SECRET=
